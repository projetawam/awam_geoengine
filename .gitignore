# ==============================================================================
# AWAM GeoEngine .gitignore
# ==============================================================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Pytest / Testing / Coverage caches
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
.venv/
env/
venv/
ENV/

# Temporary data caches, pickle files & partial downloads
.cache/
**/pixel_indices_database/.cache/
**/cache_precip/
**/_cache_panel_*.pkl
*.pkl

# Execution logs
*.log
logs/*.log
!logs/.gitkeep

# System & IDE configuration files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
